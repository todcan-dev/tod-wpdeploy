#!/usr/bin/env bash
set -euo pipefail

# wpdeploy :: tod — thin command dispatcher, mirroring WordOps' `wo` UX.
# Every subcommand just execs the matching script sitting next to this
# one; all the real logic lives there. See setup-server.sh / create-site.sh
# / list-sites.sh / delete-site.sh --help for flags.

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SELF")" && pwd)"

usage() {
    cat <<EOF
tod — wpdeploy command line

  tod setup [--php-version 8.3] [--acme-email you@example.com]
            [--mysql-root-password 'secret']
            [--admin-user name] [--admin-email you@example.com]
            [--ssh-allow-ip <ip-or-cidr>|any]
            [--disable-password-auth yes|no]
            [--default-plugins "slug-a,slug-b"]
      Bootstrap this server. Run once, as root. Safe to re-run.
      Run from a real terminal and it prompts for whatever wasn't passed
      as a flag (admin username/email, SSH lockdown IP, SSH key-only
      login); piped/CI runs skip prompts and use flags or safe defaults.
      --admin-user/--admin-email set the default WP admin every site
      created afterward uses, unless overridden on 'tod site create'.
      --ssh-allow-ip restricts SSH to one IP/CIDR instead of the whole
      internet; pass 'any' to leave it open.
      --disable-password-auth yes turns off SSH password login (key-only
      from then on) -- refuses to if it can't find an authorized key for
      the account you connected as, so you can't lock yourself out.
      --default-plugins is a comma-separated list of wordpress.org slugs
      installed and activated on every site created afterward, on top of
      the Redis object cache. Akismet and Hello Dolly are always removed.

  tod site create <domain> [--title "..."] [--admin-user name]
                            [--admin-email you@example.com]
                            [--admin-password 'secret'] [--dry-run]
      Provision an isolated WordPress site. Run as root.

  tod site delete <domain> [--yes] [--dry-run]
      Permanently remove a site: Linux user, files, database, PHP-FPM
      pool, nginx vhost, TLS certificate, its dedicated Redis instance.
      Not reversible. Prompts for typed confirmation unless --yes is given.

  tod site list [--verbose]
      List provisioned sites.

  tod help
      Show this message.
EOF
}

[[ $# -gt 0 ]] || { usage; exit 1; }

case "$1" in
    setup)
        shift
        exec "$DIR/setup-server.sh" "$@"
        ;;
    site)
        shift
        case "${1:-}" in
            create)
                shift
                exec "$DIR/create-site.sh" "$@"
                ;;
            delete)
                shift
                exec "$DIR/delete-site.sh" "$@"
                ;;
            list)
                shift
                exec "$DIR/list-sites.sh" "$@"
                ;;
            *)
                echo "Usage: tod site <create|delete|list> ..." >&2
                exit 1
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: '$1'" >&2
        usage
        exit 1
        ;;
esac
