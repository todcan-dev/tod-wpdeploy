; wpdeploy — PHP-FPM pool for __POOL_NAME__
;
; Isolation: this pool runs as its own dedicated user:group and listens on
; its own unix socket, so a compromised worker can only touch this site's
; files/processes — never another site's pool or socket.
[__POOL_NAME__]
user = __USER__
group = __GROUP__

; Socket, not TCP: not reachable from other pools or the network at all.
; group=www-data + mode 0660 is what lets nginx (running as www-data)
; connect to it, without any other site's user needing access.
listen = __SOCKET__
listen.owner = __USER__
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
pm.max_requests = 500

; Confines every file operation this pool's PHP can do to its own site's
; directory tree (__SITE_BASE__, one level above the nginx-served htdocs/,
; so wp-config.php can live outside anything nginx's `root` can ever
; reach) plus /tmp. Still exclusively this one site's files -- a
; compromised plugin/theme cannot read or write another site's
; wp-config.php, uploads, etc.
php_admin_value[open_basedir] = __SITE_BASE__:/tmp

; Blocks the shell-out/fork functions most WordPress malware relies on for
; persistence and lateral movement. If a specific plugin legitimately needs
; one of these, remove it here for this pool only — never globally.
php_admin_value[disable_functions] = exec,shell_exec,system,passthru,proc_open,popen

php_flag[display_errors] = off
catch_workers_output = yes
